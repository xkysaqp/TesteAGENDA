@{
    ViewData["Title"] = "Acesso Negado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-danger">
                <div class="card-body p-5">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                    <h2 class="card-title text-danger mt-3">Acesso Negado</h2>
                    <p class="card-text text-muted">
                        Você não tem permissão para acessar esta página.
                    </p>
                    <p class="card-text">
                        <small class="text-muted">
                            Se você acredita que isso é um erro, entre em contato com o administrador.
                        </small>
                    </p>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                            <i class="fas fa-home me-2"></i>Página Inicial
                        </a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Voltar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 