@model AgendaApp.Web.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-circle me-2"></i>Meu Perfil
                    </h4>
                    @if (Model.EhAdmin)
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="fas fa-crown me-1"></i>Administrador
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-store me-1"></i>Usuário de Loja
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Profile" asp-controller="Account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">@Html.DisplayNameFor(m => m.Nome)</label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Html.DisplayNameFor(m => m.Email)</label>
                            <input asp-for="Email" class="form-control" readonly />
                            <div class="form-text">O email não pode ser alterado</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Telefone" class="form-label">@Html.DisplayNameFor(m => m.Telefone)</label>
                                    <input asp-for="Telefone" class="form-control" />
                                    <span asp-validation-for="Telefone" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CNPJ" class="form-label">@Html.DisplayNameFor(m => m.CNPJ)</label>
                                    <input asp-for="CNPJ" class="form-control" placeholder="00.000.000/0000-00" />
                                    <span asp-validation-for="CNPJ" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AreaAtuacao" class="form-label">@Html.DisplayNameFor(m => m.AreaAtuacao)</label>
                            <input asp-for="AreaAtuacao" class="form-control" placeholder="Ex: Medicina, Advocacia..." />
                            <span asp-validation-for="AreaAtuacao" class="text-danger"></span>
                        </div>

                        @if (Model.UltimoAcesso.HasValue)
                        {
                            <div class="alert alert-light">
                                <strong>Último Acesso:</strong> @Model.UltimoAcesso.Value.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Voltar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Máscara para telefone e CNPJ
        $(document).ready(function() {
            $('#Telefone').mask('(00) 00000-0000');
            $('#CNPJ').mask('00.000.000/0000-00');
        });
    </script>
} 