        // Função para adicionar serviço da lista ao prestador
        function adicionarServicoDaLista(servicoId, servicoNome, servicoDescricao, servicoValor, servicoDuracao) {
            // Verificar se já existe serviço com o mesmo nome
            if (servicosEspecificos.some(s => s.nome.toLowerCase() === servicoNome.toLowerCase())) {
                Swal.fire({
                    title: 'Atenção!',
                    text: 'Já existe um serviço com este nome na lista.',
                    icon: 'warning'
                });
                return;
            }

            // Adicionar serviço à lista temporária
            const novoServico = {
                id: servicoIdCounter++,
                nome: servicoNome,
                descricao: servicoDescricao,
                valor: servicoValor,
                duracaoEmMinutos: servicoDuracao,
                ativo: true
            };

            servicosEspecificos.push(novoServico);

            // Atualizar interface
            atualizarListaServicosEspecificos();

            // Fechar modal
            bootstrap.Modal.getInstance(document.getElementById('selecionarServicoModal')).hide();

            Swal.fire({
                title: 'Sucesso!',
                text: `Serviço "${servicoNome}" adicionado à lista.`,
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            });
