                // Permitir apenas números, vírgula e ponto durante a digitação
        document.getElementById('servicoValor').addEventListener('input', function(e) {
            // Remove caracteres inválidos enquanto digita
            let value = e.target.value;
            let filteredValue = value.replace(/[^\d,\.]/g, '');
            
            // Permite apenas uma vírgula ou ponto
            let commaCount = (filteredValue.match(/,/g) || []).length;
            let dotCount = (filteredValue.match(/\./g) || []).length;
            
            if (commaCount > 1 || dotCount > 1 || (commaCount > 0 && dotCount > 0)) {
                // Se há múltiplos separadores, manter apenas o primeiro
                let hasComma = filteredValue.indexOf(',');
                let hasDot = filteredValue.indexOf('.');
                
                if (hasComma >= 0 && hasDot >= 0) {
                    // Se tem ambos, manter o primeiro encontrado
                    if (hasComma < hasDot) {
                        filteredValue = filteredValue.replace(/\./g, '');
                    } else {
                        filteredValue = filteredValue.replace(/,/g, '');
                    }
                } else if (commaCount > 1) {
                    // Múltiplas vírgulas
                    let parts = filteredValue.split(',');
                    filteredValue = parts[0] + ',' + parts.slice(1).join('');
                } else if (dotCount > 1) {
                    // Múltiplos pontos
                    let parts = filteredValue.split('.');
                    filteredValue = parts[0] + '.' + parts.slice(1).join('');
                }
            }
            
            if (value !== filteredValue) {
                e.target.value = filteredValue;
            }
        });

        // Formatação e validação do valor monetário (pt-BR)
        document.getElementById('servicoValor').addEventListener('blur', function(e) {
            let inputValue = e.target.value.trim();
            
            // Remove espaços e caracteres inválidos (exceto números, vírgula e ponto)
            inputValue = inputValue.replace(/[^\d,\.]/g, '');
            
            // Aceita tanto vírgula quanto ponto como separador decimal
            let value = parseFloat(inputValue.replace(',', '.'));
            
            if (!isNaN(value) && value >= 0) {
                // Formatar para pt-BR (vírgula como separador)
                e.target.value = value.toFixed(2).replace('.', ',');
                e.target.classList.remove('is-invalid');
                e.target.classList.add('is-valid');
            } else if (inputValue !== '') {
                // Se há valor mas é inválido
                e.target.classList.remove('is-valid');
                e.target.classList.add('is-invalid');
            } else {
                // Campo vazio, remover classes de validação
                e.target.classList.remove('is-valid', 'is-invalid');
            }
        });

        // Integração com o formulário principal do prestador
        window.servicosEspecificos = servicosEspecificos;

