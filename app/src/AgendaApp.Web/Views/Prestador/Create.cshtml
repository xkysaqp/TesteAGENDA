                    // Atualizar contador para próximos horários
                    if (horariosDisponiveis.length > 0) {
                        horarioIdCounter = Math.max(...horariosDisponiveis.map(h => h.id)) + 1;
                    }
                    
                    // Atualizar interface
                    atualizarListaHorarios();
                }
            } catch (error) {
                console.error('Erro ao recarregar horários preservados:', error);
            }
            </text>
        }
    </script>
}