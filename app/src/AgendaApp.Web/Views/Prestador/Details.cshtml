@model AgendaApp.Web.ViewModels.PrestadorViewModel
@{
    ViewData["Title"] = "Detalhes do Prestador";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-md me-2"></i>Detalhes do Prestador
        </h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning shadow-sm me-2">
                <i class="fas fa-edit fa-sm text-white-50 me-2"></i>Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary shadow-sm">
                <i class="fas fa-arrow-left fa-sm text-white-50 me-2"></i>Voltar
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Informações do Prestador -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user me-2"></i>Informações Pessoais
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <h5 class="text-primary">@Model.Nome</h5>
                            <p class="text-muted mb-2">
                                <i class="fas fa-briefcase me-2"></i>@Model.AreaAtuacao
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            @if (Model.Ativo)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="fas fa-check me-1"></i>Ativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="fas fa-times me-1"></i>Inativo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">E-mail</label>
                            <div class="h6">
                                <i class="fas fa-envelope me-2"></i>
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Telefone</label>
                            <div class="h6">
                                <i class="fas fa-phone me-2"></i>
                                <a href="tel:@Model.Telefone" class="text-decoration-none">@Model.Telefone</a>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CNPJ))
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">CNPJ</label>
                                <div class="h6">
                                    <i class="fas fa-id-card me-2"></i>
                                    <code>@Model.CNPJ</code>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.DataCriacao.HasValue)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Data de Cadastro</label>
                                <div class="h6">
                                    <i class="fas fa-calendar me-2"></i>
                                    @Model.DataCriacao.Value.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Seção de Serviços Reorganizada -->
        <div class="col-lg-6">
            <!-- Serviços Específicos do Prestador -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-cogs me-2"></i>Serviços Específicos (<span id="count-servicos-especificos">@(Model.Servicos?.Count ?? 0)</span>)
                    </h6>
                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#adicionarServicoModal">
                        <i class="fas fa-plus fa-sm me-1"></i>Novo Serviço
                    </button>
                </div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    <div id="lista-servicos-especificos">
                        @if (Model.Servicos != null && Model.Servicos.Any())
                        {
                            @foreach (var servico in Model.Servicos)
                            {
                                <div class="card border-left-primary mb-3">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="text-primary mb-1">@servico.Nome</h6>
                                                <p class="text-muted small mb-2">@servico.Descricao</p>
                                                <div class="d-flex gap-2">
                                                    <span class="badge bg-success">
                                                        R$ @servico.Valor.ToString("F2")
                                                    </span>
                                                    <span class="badge bg-info">
                                                        @{
                                                            var horas = servico.DuracaoEmMinutos / 60;
                                                            var minutos = servico.DuracaoEmMinutos % 60;
                                                            var duracao = horas > 0 ? $"{horas}h {minutos.ToString("00")}min" : $"{minutos}min";
                                                        }
                                                        @duracao
                                                    </span>
                                                    <span class="badge bg-secondary">
                                                        <i class="fas fa-user me-1"></i>Específico
                                                    </span>
                                                    @if (servico.Ativo)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check fa-sm"></i> Ativo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-times fa-sm"></i> Inativo
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="dropdown">
                                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <a class="dropdown-item" asp-controller="Servico" asp-action="Edit" asp-route-id="@servico.Id">
                                                            <i class="fas fa-edit me-2"></i>Editar
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item text-danger btn-delete-ajax" 
                                                                data-delete-url="@Url.Action("DeleteAjax", "Servico", new { id = servico.Id })"
                                                                data-item-name="o serviço '@servico.Nome'"
                                                                data-confirm-message="Tem certeza que deseja excluir o serviço '@servico.Nome'?"
                                                                data-item-details="<strong>Valor:</strong> R$ @servico.Valor.ToString("F2")<br><strong>Duração:</strong> @(servico.DuracaoEmMinutos / 60 > 0 ? $"{servico.DuracaoEmMinutos / 60}h {(servico.DuracaoEmMinutos % 60).ToString("00")}min" : $"{servico.DuracaoEmMinutos}min")<br><strong>Status:</strong> @(servico.Ativo ? "Ativo" : "Inativo")">
                                                            <i class="fas fa-trash me-2"></i>Excluir
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3" id="empty-servicos-especificos">
                                <i class="fas fa-user-cog fa-2x text-muted mb-2"></i>
                                <p class="text-muted small">Nenhum serviço específico criado.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Serviços Globais Vinculados -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-link me-2"></i>Serviços Vinculados (<span id="count-servicos-vinculados">0</span>)
                    </h6>
                    <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#vincularServicoModal">
                        <i class="fas fa-link fa-sm me-1"></i>Vincular Serviço
                    </button>
                </div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    <div id="lista-servicos-vinculados">
                        <div class="text-center py-3" id="empty-servicos-vinculados">
                            <i class="fas fa-link fa-2x text-muted mb-2"></i>
                            <p class="text-muted small">Nenhum serviço global vinculado.</p>
                            <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#vincularServicoModal">
                                <i class="fas fa-link me-2"></i>Vincular Primeiro Serviço
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Adicionar Serviço Específico -->
<div class="modal fade" id="adicionarServicoModal" tabindex="-1" aria-labelledby="adicionarServicoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="adicionarServicoModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Criar Novo Serviço Específico
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAdicionarServico" action="@Url.Action("AdicionarServico", "Prestador")" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PrestadorId" value="@Model.Id" />
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" name="Nome" id="servicoNome" placeholder="Nome do Serviço" required>
                                <label for="servicoNome">Nome do Serviço</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" name="Valor" id="servicoValor" placeholder="Valor" required pattern="^[0-9]+([,\.][0-9]{1,2})?$">
                                <label for="servicoValor">Valor (R$)</label>
                                <div class="invalid-feedback">Digite um valor válido (ex: 32,50)</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-floating mb-3">
                                <textarea class="form-control" name="Descricao" id="servicoDescricao" placeholder="Descrição" style="height: 100px"></textarea>
                                <label for="servicoDescricao">Descrição</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" name="DuracaoEmMinutos" id="servicoDuracao" min="1" placeholder="Duração" required>
                                <label for="servicoDuracao">Duração (minutos)</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Ativo" id="servicoAtivo" value="true" checked>
                                <input type="hidden" name="Ativo" value="false">
                                <label class="form-check-label" for="servicoAtivo">
                                    <i class="fas fa-check-circle text-success me-1"></i>
                                    Serviço Ativo
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Debug Area - Remover em produção -->
                    <div class="row mt-3" style="display: none;" id="debugArea">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h6>Debug - Dados do Formulário:</h6>
                                <pre id="debugData"></pre>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-2"></i>Salvar Serviço
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Vincular Serviço Global -->
<div class="modal fade" id="vincularServicoModal" tabindex="-1" aria-labelledby="vincularServicoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="vincularServicoModalLabel">
                    <i class="fas fa-link me-2"></i>Vincular Serviço Global
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="loading-servicos-globais" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-2">Carregando serviços disponíveis...</p>
                </div>
                
                <div id="lista-servicos-globais-disponiveis">
                    <!-- Lista será carregada via JavaScript -->
                </div>
                
                <div id="no-servicos-globais" class="text-center py-4" style="display: none;">
                    <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Não há serviços globais disponíveis para vincular.</p>
                    <p class="text-muted small">Todos os serviços globais da loja já estão vinculados a este prestador.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Serviço Vinculado -->
<div class="modal fade" id="editarServicoVinculadoModal" tabindex="-1" aria-labelledby="editarServicoVinculadoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="editarServicoVinculadoModalLabel">
                    <i class="fas fa-edit me-2"></i>Personalizar Serviço Vinculado
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditarServicoVinculado">
                <div class="modal-body">
                    <input type="hidden" id="prestadorServicoId" name="prestadorServicoId">
                    
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Serviço:</strong> <span id="servicoNomeEdicao"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Valor Padrão</label>
                                <input type="text" id="valorPadraoEdicao" class="form-control" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Duração Padrão</label>
                                <input type="text" id="duracaoPadraoEdicao" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="valorPersonalizado" class="form-label">
                                    Valor Personalizado <small class="text-muted">(opcional)</small>
                                </label>
                                <input type="text" id="valorPersonalizado" name="valorPersonalizado" class="form-control" 
                                       pattern="^[0-9]+([,\.][0-9]{1,2})?$" placeholder="Ex: 50,00">
                                <div class="form-text">Deixe vazio para usar o valor padrão</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="duracaoPersonalizada" class="form-label">
                                    Duração Personalizada <small class="text-muted">(opcional)</small>
                                </label>
                                <input type="number" id="duracaoPersonalizada" name="duracaoPersonalizada" class="form-control" 
                                       min="15" max="1440" placeholder="Ex: 60">
                                <div class="form-text">Deixe vazio para usar a duração padrão (em minutos)</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save me-2"></i>Salvar Personalização
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>


        // Submissão do formulário via AJAX
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('formAdicionarServico');
            if (!form) {
                console.error('Formulário formAdicionarServico não encontrado!');
                return;
            }

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Validação básica antes do envio
                const nome = document.getElementById('servicoNome').value.trim();
                const valorInput = document.getElementById('servicoValor').value;
                const valor = parseFloat(valorInput.replace(',', '.')); // Converte vírgula para ponto
                const duracao = parseInt(document.getElementById('servicoDuracao').value);

            
            // Validações específicas
            if (!nome || nome.length < 2) {
                Swal.fire({
                    title: 'Erro de Validação!',
                    text: 'Nome do serviço deve ter pelo menos 2 caracteres.',
                    icon: 'error'
                });
                return;
            }
            
            if (!valor || valor < 0.01) {
                Swal.fire({
                    title: 'Erro de Validação!',
                    text: 'Valor deve ser maior que R$ 0,01.',
                    icon: 'error'
                });
                return;
            }
            
            if (!duracao || duracao < 1) {
                Swal.fire({
                    title: 'Erro de Validação!',
                    text: 'Duração deve ser de pelo menos 1 minuto.',
                    icon: 'error'
                });
                return;
            }
            
            // Criar FormData (pt-BR usa vírgula como separador)
            const formData = new FormData(this);
            
            console.log('=== DEBUG FORMDATA ===');
            for (let pair of formData.entries()) {
                console.log(`${pair[0]}: ${pair[1]}`);
            }
            
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            
            // Desabilitar botão e mostrar loading
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Salvando...';
            
            fetch(this.action, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers);
                
                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('adicionarServicoModal')).hide();
                    
                    Swal.fire({
                        title: 'Sucesso!',
                        text: 'Serviço adicionado com sucesso.',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    // Tentar ler o JSON da resposta de erro
                    response.text().then(responseText => {
                        console.log('Response text:', responseText);
                        
                        let errorData = {};
                        try {
                            errorData = JSON.parse(responseText);
                        } catch (jsonError) {
                            console.error('Erro ao fazer parse do JSON:', jsonError);
                            console.log('Response text bruto:', responseText);
                        }
                        
                        console.error('Erro do servidor:', errorData);
                        
                        let errorMessage = 'Erro ao adicionar serviço.';
                        
                        if (errorData.message) {
                            errorMessage = errorData.message;
                        }
                        
                        // Processar erros de validação
                        if (errorData.errors && Array.isArray(errorData.errors)) {
                            const validationErrors = errorData.errors.map(error => {
                                const fieldName = error.Field.replace('model.', '').replace('Model.', '');
                                const errorMessages = Array.isArray(error.Errors) ? error.Errors : [error.Errors];
                                return `• ${fieldName}: ${errorMessages.join(', ')}`;
                            }).join('\n');
                            
                            errorMessage += '\n\nErros de validação:\n' + validationErrors;
                        }
                        
                        Swal.fire({
                            title: 'Erro de Validação!',
                            text: errorMessage,
                            icon: 'error',
                            width: '500px'
                        });
                    }).catch(textError => {
                        console.error('Erro ao ler resposta como texto:', textError);
                        Swal.fire({
                            title: 'Erro!',
                            text: `Erro ${response.status}: ${response.statusText}`,
                            icon: 'error'
                        });
                    });
                }
            })
            .catch(error => {
                console.error('Erro:', error);
                Swal.fire({
                    title: 'Erro!',
                    text: 'Erro de conexão. Verifique sua internet e tente novamente.',
                    icon: 'error'
                });
            })
            .finally(() => {
                // Restaurar botão
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            });
            });
        });

        // Limpar formulário quando modal for fechado
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('adicionarServicoModal');
            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    const form = document.getElementById('formAdicionarServico');
                    const debugArea = document.getElementById('debugArea');
                    if (form) form.reset();
                    if (debugArea) debugArea.style.display = 'none';
                });
            }
        });

        // Formatação e validação do valor monetário (pt-BR)
        document.getElementById('servicoValor').addEventListener('blur', function(e) {
            let inputValue = e.target.value.trim();
            
            // Remove espaços e caracteres inválidos (exceto números, vírgula e ponto)
            inputValue = inputValue.replace(/[^\d,\.]/g, '');
            
            // Aceita tanto vírgula quanto ponto como separador decimal
            let value = parseFloat(inputValue.replace(',', '.'));
            
            if (!isNaN(value) && value >= 0) {
                // Formatar para pt-BR (vírgula como separador)
                e.target.value = value.toFixed(2).replace('.', ',');
                e.target.classList.remove('is-invalid');
                e.target.classList.add('is-valid');
            } else if (inputValue !== '') {
                // Se há valor mas é inválido
                e.target.classList.remove('is-valid');
                e.target.classList.add('is-invalid');
            } else {
                // Campo vazio, remover classes de validação
                e.target.classList.remove('is-valid', 'is-invalid');
            }
        });

        // ===========================================
        // FUNCIONALIDADES DOS SERVIÇOS VINCULADOS
        // ===========================================

        let servicosVinculados = [];
        const prestadorId = '@Model.Id';

        // Carregar serviços vinculados ao abrir a página
        document.addEventListener('DOMContentLoaded', function() {
            carregarServicosVinculados();
        });

        // Event listener para o modal de vincular serviço
        document.getElementById('vincularServicoModal').addEventListener('show.bs.modal', function() {
            carregarServicosGlobaisDisponiveis();
        });

        // Carregar serviços vinculados
        async function carregarServicosVinculados() {
            try {
                const response = await fetch(`@Url.Action("ObterServicosVinculados", "Prestador")?prestadorId=${prestadorId}`);
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        servicosVinculados = result.data || [];
                        renderizarServicosVinculados();
                    }
                } else {
                    console.error('Erro ao carregar serviços vinculados:', response.statusText);
                }
            } catch (error) {
                console.error('Erro ao carregar serviços vinculados:', error);
            }
        }

        // Renderizar lista de serviços vinculados
        function renderizarServicosVinculados() {
            const container = document.getElementById('lista-servicos-vinculados');
            const countElement = document.getElementById('count-servicos-vinculados');
            const emptyElement = document.getElementById('empty-servicos-vinculados');

            if (servicosVinculados.length === 0) {
                emptyElement.style.display = 'block';
                countElement.textContent = '0';
                return;
            }

            emptyElement.style.display = 'none';
            countElement.textContent = servicosVinculados.length;

            const html = servicosVinculados.map(servico => `
                <div class="card border-left-info mb-3">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6 class="text-info mb-1">${servico.servicoNome}</h6>
                                <p class="text-muted small mb-2">${servico.servicoDescricao}</p>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-success">
                                        R$ ${servico.valorEfetivoFormatado}
                                        ${servico.temValorPersonalizado ? '<i class="fas fa-star fa-xs ms-1" title="Valor personalizado"></i>' : ''}
                                    </span>
                                    <span class="badge bg-info">
                                        ${servico.duracaoEfetivaFormatada}
                                        ${servico.temDuracaoPersonalizada ? '<i class="fas fa-star fa-xs ms-1" title="Duração personalizada"></i>' : ''}
                                    </span>
                                    <span class="badge bg-primary">
                                        <i class="fas fa-globe me-1"></i>Global
                                    </span>
                                    ${servico.temValorPersonalizado || servico.temDuracaoPersonalizada ? 
                                        '<span class="badge bg-warning text-dark"><i class="fas fa-star me-1"></i>Personalizado</span>' : ''}
                                </div>
                                ${servico.temValorPersonalizado || servico.temDuracaoPersonalizada ? `
                                <div class="mt-2">
                                    <small class="text-muted">
                                        Padrão: R$ ${servico.valorPadraoFormatado} • ${servico.duracaoPadraoFormatada}
                                    </small>
                                </div>
                                ` : ''}
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <button class="dropdown-item" onclick="editarServicoVinculado('${servico.prestadorServicoId}')">
                                            <i class="fas fa-edit me-2"></i>Personalizar
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item text-danger" onclick="desvincularServico('${servico.prestadorServicoId}', '${servico.servicoNome}')">
                                            <i class="fas fa-unlink me-2"></i>Desvincular
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

            container.innerHTML = html;
        }

        // Carregar serviços globais disponíveis
        async function carregarServicosGlobaisDisponiveis() {
            const loadingElement = document.getElementById('loading-servicos-globais');
            const listaElement = document.getElementById('lista-servicos-globais-disponiveis');
            const noServicosElement = document.getElementById('no-servicos-globais');

            // Mostrar loading
            loadingElement.style.display = 'block';
            listaElement.innerHTML = '';
            noServicosElement.style.display = 'none';

            try {
                const response = await fetch(`@Url.Action("ObterServicosGlobaisDisponiveis", "Prestador")?prestadorId=${prestadorId}`);
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        const servicosDisponiveis = result.data || [];
                        renderizarServicosGlobaisDisponiveis(servicosDisponiveis);
                    } else {
                        mostrarErro('Erro ao carregar serviços: ' + result.message);
                    }
                } else {
                    mostrarErro('Erro ao carregar serviços disponíveis');
                }
            } catch (error) {
                console.error('Erro ao carregar serviços globais:', error);
                mostrarErro('Erro de conexão');
            } finally {
                loadingElement.style.display = 'none';
            }
        }

        // Renderizar serviços globais disponíveis
        function renderizarServicosGlobaisDisponiveis(servicos) {
            const listaElement = document.getElementById('lista-servicos-globais-disponiveis');
            const noServicosElement = document.getElementById('no-servicos-globais');

            if (servicos.length === 0) {
                noServicosElement.style.display = 'block';
                return;
            }

            const html = servicos.map(servico => `
                <div class="card mb-3 ${servico.jaVinculado ? 'border-secondary' : 'border-success'}">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6 class="mb-1 ${servico.jaVinculado ? 'text-muted' : 'text-success'}">${servico.nome}</h6>
                                <p class="text-muted small mb-2">${servico.descricao}</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-success">R$ ${servico.valorFormatado}</span>
                                    <span class="badge bg-info">${servico.duracaoFormatada}</span>
                                    <span class="badge bg-primary">
                                        <i class="fas fa-globe me-1"></i>Global
                                    </span>
                                    ${servico.jaVinculado ? '<span class="badge bg-secondary">Já Vinculado</span>' : ''}
                                </div>
                            </div>
                            ${!servico.jaVinculado ? `
                            <button class="btn btn-success btn-sm" onclick="vincularServico('${servico.id}', '${servico.nome}')">
                                <i class="fas fa-link me-1"></i>Vincular
                            </button>
                            ` : ''}
                        </div>
                    </div>
                </div>
            `).join('');

            listaElement.innerHTML = html;
        }

        // Vincular serviço
        async function vincularServico(servicoId, servicoNome) {
            try {
                const formData = new FormData();
                formData.append('PrestadorId', prestadorId);
                formData.append('ServicoId', servicoId);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('@Url.Action("VincularServico", "Prestador")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        title: 'Sucesso!',
                        text: result.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                    // Fechar modal e recarregar listas
                    const modal = bootstrap.Modal.getInstance(document.getElementById('vincularServicoModal'));
                    modal.hide();
                    
                    await carregarServicosVinculados();
                } else {
                    mostrarErro(result.message);
                }
            } catch (error) {
                console.error('Erro ao vincular serviço:', error);
                mostrarErro('Erro de conexão');
            }
        }

        // Editar serviço vinculado
        async function editarServicoVinculado(prestadorServicoId) {
            const servico = servicosVinculados.find(s => s.prestadorServicoId === prestadorServicoId);
            if (!servico) return;

            // Preencher modal
            document.getElementById('prestadorServicoId').value = prestadorServicoId;
            document.getElementById('servicoNomeEdicao').textContent = servico.servicoNome;
            document.getElementById('valorPadraoEdicao').value = servico.valorPadraoFormatado;
            document.getElementById('duracaoPadraoEdicao').value = servico.duracaoPadraoFormatada;
            
            // Preencher valores personalizados (se existirem)
            document.getElementById('valorPersonalizado').value = servico.valorPersonalizado ? 
                servico.valorPersonalizado.toFixed(2).replace('.', ',') : '';
            document.getElementById('duracaoPersonalizada').value = servico.duracaoPersonalizadaEmMinutos || '';

            // Abrir modal
            const modal = new bootstrap.Modal(document.getElementById('editarServicoVinculadoModal'));
            modal.show();
        }

        // Form de editar serviço vinculado
        document.getElementById('formEditarServicoVinculado').addEventListener('submit', async function(e) {
            e.preventDefault();

            try {
                const formData = new FormData(this);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('@Url.Action("AtualizarServicoVinculado", "Prestador")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        title: 'Sucesso!',
                        text: result.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                    // Fechar modal e recarregar lista
                    const modal = bootstrap.Modal.getInstance(document.getElementById('editarServicoVinculadoModal'));
                    modal.hide();
                    
                    await carregarServicosVinculados();
                } else {
                    mostrarErro(result.message);
                }
            } catch (error) {
                console.error('Erro ao atualizar serviço vinculado:', error);
                mostrarErro('Erro de conexão');
            }
        });

        // Desvincular serviço
        async function desvincularServico(prestadorServicoId, servicoNome) {
            const result = await Swal.fire({
                title: 'Confirmar Desvinculação',
                text: `Tem certeza que deseja desvincular o serviço "${servicoNome}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sim, desvincular',
                cancelButtonText: 'Cancelar'
            });

            if (!result.isConfirmed) return;

            try {
                const formData = new FormData();
                formData.append('prestadorServicoId', prestadorServicoId);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('@Url.Action("RemoverVinculacaoServico", "Prestador")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        title: 'Sucesso!',
                        text: result.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                    await carregarServicosVinculados();
                } else {
                    mostrarErro(result.message);
                }
            } catch (error) {
                console.error('Erro ao desvincular serviço:', error);
                mostrarErro('Erro de conexão');
            }
        }

        // Função auxiliar para mostrar erros
        function mostrarErro(mensagem) {
            Swal.fire({
                title: 'Erro!',
                text: mensagem,
                icon: 'error'
            });
        }

        // Formatting para campos de valor personalizado
        document.getElementById('valorPersonalizado').addEventListener('input', function(e) {
            let value = e.target.value;
            let filteredValue = value.replace(/[^\\d,\\.]/g, '');

            let commaCount = (filteredValue.match(/,/g) || []).length;
            let dotCount = (filteredValue.match(/\\./g) || []).length;

            if (commaCount > 1 || dotCount > 1 || (commaCount > 0 && dotCount > 0)) {
                let hasComma = filteredValue.indexOf(',');
                let hasDot = filteredValue.indexOf('.');

                if (hasComma >= 0 && hasDot >= 0) {
                    if (hasComma < hasDot) {
                        filteredValue = filteredValue.replace(/\\./g, '');
                    } else {
                        filteredValue = filteredValue.replace(/,/g, '');
                    }
                } else if (commaCount > 1) {
                    let parts = filteredValue.split(',');
                    filteredValue = parts[0] + ',' + parts.slice(1).join('');
                } else if (dotCount > 1) {
                    let parts = filteredValue.split('.');
                    filteredValue = parts[0] + '.' + parts.slice(1).join('');
                }
            }

            if (value !== filteredValue) {
                e.target.value = filteredValue;
            }
        });

        document.getElementById('valorPersonalizado').addEventListener('blur', function(e) {
            let inputValue = e.target.value.trim();

            if (inputValue === '') {
                e.target.classList.remove('is-valid', 'is-invalid');
                return;
            }

            inputValue = inputValue.replace(/[^\\d,\\.]/g, '');
            let value = parseFloat(inputValue.replace(',', '.'));

            if (!isNaN(value) && value >= 0) {
                e.target.value = value.toFixed(2).replace('.', ',');
                e.target.classList.remove('is-invalid');
                e.target.classList.add('is-valid');
            } else {
                e.target.classList.remove('is-valid');
                e.target.classList.add('is-invalid');
            }
        });

    </script>
} 