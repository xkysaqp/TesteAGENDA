@model List<AgendaApp.Web.ViewModels.ServicoListViewModel>
@{
    ViewData["Title"] = "Serviços";
    var filtro = ViewBag.Filtro as AgendaApp.Web.ViewModels.ServicoFiltroViewModel;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-cogs text-success me-2"></i>Serviços
            @if (ViewBag.IsLojaUser == true)
            {
                <small class="text-muted">da sua loja</small>
            }
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Novo Serviço
        </a>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Filtros
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="Nome" class="form-label">Nome</label>
                            <input name="Nome" value="@filtro?.Nome" class="form-control" placeholder="Buscar por nome..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="PrestadorId" class="form-label">Prestador</label>
                            <select name="PrestadorId" asp-items="@ViewBag.Prestadores" class="form-select">
                                <option value="">Todos os prestadores</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="ValorMinimo" class="form-label">Valor Mínimo</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input name="ValorMinimo" value="@filtro?.ValorMinimo" class="form-control" placeholder="0,00" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="ValorMaximo" class="form-label">Valor Máximo</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input name="ValorMaximo" value="@filtro?.ValorMaximo" class="form-control" placeholder="1000,00" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    @if (ViewBag.IsLojaUser != true)
                    {
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="LojaId" class="form-label">Loja</label>
                                <select name="LojaId" asp-items="@ViewBag.Lojas" class="form-select">
                                    <option value="">Todas as lojas</option>
                                </select>
                            </div>
                        </div>
                    }
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="DuracaoMaxima" class="form-label">Duração Máxima (min)</label>
                            <input name="DuracaoMaxima" value="@filtro?.DuracaoMaxima" class="form-control" placeholder="120" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" name="ApenasAtivos" value="true" 
                                   @(filtro?.ApenasAtivos != false ? "checked" : "") />
                            <label class="form-check-label" for="ApenasAtivos">
                                Apenas ativos
                            </label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="fas fa-search me-2"></i>Filtrar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Limpar
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Lista de Serviços -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>
                                    <i class="fas fa-tag me-1"></i>Serviço
                                </th>
                                <th>
                                    <i class="fas fa-user-md me-1"></i>Prestador
                                </th>
                                <th>
                                    <i class="fas fa-dollar-sign me-1"></i>Valor
                                </th>
                                <th>
                                    <i class="fas fa-clock me-1"></i>Duração
                                </th>
                                <th>
                                    <i class="fas fa-toggle-on me-1"></i>Status
                                </th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var servico in Model)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <strong>@servico.Nome</strong>
                                            <br><small class="text-muted">@servico.Descricao</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@servico.PrestadorNome</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@servico.ValorFormatado</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@servico.DuracaoFormatada</span>
                                    </td>
                                    <td>
                                        @if (servico.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times me-1"></i>Inativo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@servico.Id" 
                                               class="btn btn-sm btn-outline-info" title="Ver detalhes">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@servico.Id" 
                                               class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-ajax" 
                                                    title="Excluir"
                                                    data-delete-url="@Url.Action("DeleteAjax", "Servico", new { id = servico.Id })"
                                                    data-item-name="o serviço '@servico.Nome'"
                                                    data-confirm-message="Tem certeza que deseja excluir o serviço '@servico.Nome'?"
                                                    data-item-details="<strong>Prestador:</strong> @servico.PrestadorNome<br><strong>Valor:</strong> @servico.ValorFormatado<br><strong>Duração:</strong> @servico.DuracaoFormatada<br><strong>Status:</strong> @(servico.Ativo ? "Ativo" : "Inativo")">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-cogs fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Nenhum serviço encontrado</h5>
                    <p class="text-muted">
                        @if (filtro != null && (!string.IsNullOrEmpty(filtro.Nome) || filtro.PrestadorId.HasValue || filtro.ValorMinimo.HasValue))
                        {
                            <span>Tente ajustar os filtros ou </span>
                        }
                        <a asp-action="Create" class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>cadastre o primeiro serviço
                        </a>
                    </p>
                </div>
            }
        </div>
    </div>
</div> 