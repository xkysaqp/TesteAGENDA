@{
    ViewData["Title"] = "Sobre o AgendaApp";
}

<!-- Hero Section -->
<section class="bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Sobre o AgendaApp</h1>
                <p class="lead">
                    Somos especialistas em transformar a gestão de agendamentos em uma experiência simples, 
                    eficiente e profissional para empresas de todos os tamanhos.
                </p>
            </div>
            <div class="col-lg-6 text-center">
                <i class="fas fa-building text-primary" style="font-size: 120px; opacity: 0.8;"></i>
            </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-bullseye fs-2"></i>
                    </div>
                    <h4>Nossa Missão</h4>
                    <p class="text-muted">
                        Simplificar a gestão de agendamentos para que empresários possam focar no que realmente importa: 
                        atender bem seus clientes e fazer seus negócios crescerem.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="text-center">
                    <div class="bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-eye fs-2"></i>
                    </div>
                    <h4>Nossa Visão</h4>
                    <p class="text-muted">
                        Ser a plataforma de agendamento mais confiável e inovadora do mercado, 
                        democratizando o acesso a ferramentas profissionais de gestão.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="text-center">
                    <div class="bg-warning text-dark rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-heart fs-2"></i>
                    </div>
                    <h4>Nossos Valores</h4>
                    <p class="text-muted">
                        Transparência, inovação, simplicidade e foco na experiência do usuário são os pilares 
                        que guiam todas as nossas decisões e desenvolvimento.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Story Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="display-6 fw-bold mb-4">Nossa História</h2>
                <p class="mb-4">
                    O AgendaApp nasceu da necessidade real de profissionais que enfrentavam dificuldades 
                    para gerenciar suas agendas de forma eficiente. Percebemos que muitas empresas perdiam 
                    clientes e oportunidades por não ter um sistema adequado de agendamento.
                </p>
                <p class="mb-4">
                    Desenvolvido com tecnologia de ponta e foco na experiência do usuário, o AgendaApp 
                    combina simplicidade de uso com recursos avançados de gestão, proporcionando uma 
                    solução completa para profissionais liberais, clínicas, salões, consultórios e 
                    diversos outros tipos de negócio.
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-center">
                            <h3 class="text-primary fw-bold">500+</h3>
                            <small class="text-muted">Empresas Atendidas</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <h3 class="text-success fw-bold">99.9%</h3>
                            <small class="text-muted">Uptime</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <h3 class="text-warning fw-bold">24/7</h3>
                            <small class="text-muted">Suporte</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <h3 class="text-info fw-bold">4.8★</h3>
                            <small class="text-muted">Avaliação Média</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <i class="fas fa-history text-muted" style="font-size: 150px; opacity: 0.6;"></i>
            </div>
        </div>
    </div>
</section>

<!-- Technology Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center display-6 fw-bold mb-5">Tecnologia de Ponta</h2>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-cloud text-primary mb-3" style="font-size: 3rem;"></i>
                        <h5>Cloud Native</h5>
                        <p class="card-text text-muted small">
                            Infraestrutura moderna na nuvem garantindo máxima disponibilidade e escalabilidade.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-mobile-alt text-success mb-3" style="font-size: 3rem;"></i>
                        <h5>Responsivo</h5>
                        <p class="card-text text-muted small">
                            Interface adaptável que funciona perfeitamente em qualquer dispositivo.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-lock text-warning mb-3" style="font-size: 3rem;"></i>
                        <h5>Seguro</h5>
                        <p class="card-text text-muted small">
                            Criptografia avançada e práticas de segurança que atendem padrões internacionais.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-rocket text-danger mb-3" style="font-size: 3rem;"></i>
                        <h5>Performance</h5>
                        <p class="card-text text-muted small">
                            Sistema otimizado para máxima velocidade e eficiência em todas as operações.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-6 fw-bold">Nossa Equipe</h2>
            <p class="lead">Profissionais dedicados a entregar a melhor experiência possível</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="row g-4">
                    <div class="col-md-6 text-center">
                        <div class="bg-white text-dark rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-code fs-2 text-primary"></i>
                        </div>
                        <h5>Desenvolvimento</h5>
                        <p class="small opacity-75">
                            Especialistas em tecnologias modernas focados em criar soluções robustas e inovadoras.
                        </p>
                    </div>
                    <div class="col-md-6 text-center">
                        <div class="bg-white text-dark rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-headset fs-2 text-success"></i>
                        </div>
                        <h5>Suporte</h5>
                        <p class="small opacity-75">
                            Equipe dedicada a garantir que você tenha a melhor experiência possível com nosso produto.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="py-5">
    <div class="container text-center">
        <h2 class="display-6 fw-bold mb-4">Entre em Contato</h2>
        <p class="lead mb-4">
            Tem alguma dúvida ou sugestão? Nossa equipe está sempre pronta para ajudar!
        </p>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="p-3">
                            <i class="fas fa-envelope text-primary fs-2 mb-3"></i>
                            <h6>Email</h6>
                            <p class="text-muted small">contato@agendaapp.com</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <i class="fas fa-phone text-success fs-2 mb-3"></i>
                            <h6>Telefone</h6>
                            <p class="text-muted small">(11) 99999-9999</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <i class="fas fa-comments text-warning fs-2 mb-3"></i>
                            <h6>Chat Online</h6>
                            <p class="text-muted small">24/7 disponível</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-3">
                <i class="fas fa-rocket me-2"></i>Começar Agora
            </a>
            <a href="#" class="btn btn-outline-primary btn-lg">
                <i class="fas fa-calendar me-2"></i>Agendar Demo
            </a>
        </div>
    </div>
</section> 