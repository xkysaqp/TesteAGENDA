@{
    ViewData["Title"] = "AgendaApp - Sistema de Agendamento Profissional";
}

<!-- Hero Section -->
<section class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">
                    Transforme seu negócio com <span class="text-warning">AgendaApp</span>
                </h1>
                <p class="lead mb-4">
                    Sistema completo de agendamento online que simplifica a gestão de horários, 
                    aumenta sua produtividade e melhora a experiência dos seus clientes.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Começar Agora
                    </a>
                    <a href="#funcionalidades" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-play-circle me-2"></i>Ver Como Funciona
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-image mt-4 mt-lg-0">
                    <i class="fas fa-calendar-check" style="font-size: 200px; opacity: 0.8;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="funcionalidades" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Por que escolher o AgendaApp?</h2>
            <p class="lead text-muted">Funcionalidades pensadas para otimizar seu tempo e aumentar seus resultados</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-user-md text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title">Gestão de Prestadores</h5>
                        <p class="card-text text-muted">
                            Gerencie sua equipe com facilidade. Cadastre prestadores, defina especialidades 
                            e acompanhe a performance individual.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-clock text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title">Horários Inteligentes</h5>
                        <p class="card-text text-muted">
                            Configure horários disponíveis por prestador e dia da semana. 
                            Sistema evita conflitos e otimiza sua agenda automaticamente.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-cogs text-warning" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title">Catálogo de Serviços</h5>
                        <p class="card-text text-muted">
                            Organize seus serviços com preços, duração e descrições detalhadas. 
                            Facilite a escolha dos seus clientes.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-store text-info" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title">Multi-Loja</h5>
                        <p class="card-text text-muted">
                            Gerencie múltiplas unidades do seu negócio em uma única plataforma. 
                            Cada loja com sua equipe e configurações independentes.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-chart-line text-danger" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title">Dashboard Inteligente</h5>
                        <p class="card-text text-muted">
                            Acompanhe métricas importantes do seu negócio com relatórios 
                            visuais e insights para tomada de decisões.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-shield-alt text-secondary" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title">Seguro & Confiável</h5>
                        <p class="card-text text-muted">
                            Seus dados protegidos com criptografia avançada. 
                            Sistema desenvolvido seguindo as melhores práticas de segurança.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Benefits Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="display-6 fw-bold mb-4">Simplifique sua gestão de agendamentos</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Redução de No-Shows</h6>
                                <p class="text-muted mb-0">Sistema de notificações automáticas reduz faltas em até 70%</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Mais Tempo para o que Importa</h6>
                                <p class="text-muted mb-0">Automatize tarefas administrativas e foque no atendimento</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Experiência do Cliente Aprimorada</h6>
                                <p class="text-muted mb-0">Interface intuitiva que seus clientes vão adorar usar</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Relatórios Detalhados</h6>
                                <p class="text-muted mb-0">Insights valiosos para otimizar seu negócio</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="mt-4 mt-lg-0">
                    <i class="fas fa-chart-bar text-primary" style="font-size: 150px; opacity: 0.8;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        <h2 class="display-6 fw-bold mb-4">Pronto para revolucionar seu negócio?</h2>
        <p class="lead mb-4">
            Junte-se a centenas de empresas que já transformaram sua gestão de agendamentos com o AgendaApp.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg px-5">
                <i class="fas fa-rocket me-2"></i>Começar Gratuitamente
            </a>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg px-5">
                <i class="fas fa-info-circle me-2"></i>Saiba Mais
            </a>
        </div>
        <small class="d-block mt-3 text-light opacity-75">
            Sem compromisso • Configuração em minutos • Suporte incluído
        </small>
    </div>
</section>

<style>
    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
    }
    
    .min-vh-75 {
        min-height: 75vh;
    }
    
    .card {
        transition: transform 0.3s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-5px);
    }
    
    .feature-icon {
        transition: transform 0.3s ease-in-out;
    }
    
    .card:hover .feature-icon {
        transform: scale(1.1);
    }
</style> 