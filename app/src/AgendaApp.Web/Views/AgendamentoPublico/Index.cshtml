@model AgendaApp.Web.ViewModels.AgendamentoPublicoViewModel
@{
    ViewData["Title"] = $"Agendar - {Model.Loja.Nome}";
    Layout = null; // Layout público sem autenticação
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Flatpickr (Date/Time Picker) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 4rem 0;
        }
        
        .service-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }
        
        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        
        .service-card.selected {
            border-color: #28a745;
            background-color: #f8fff9;
        }
        
        .time-slot {
            padding: 0.5rem 1rem;
            margin: 0.25rem;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .time-slot:hover {
            background-color: #e9ecef;
        }
        
        .time-slot.selected {
            background-color: #28a745;
            color: white;
            border-color: #28a745;
        }
        
        .time-slot.unavailable {
            background-color: #f8f9fa;
            color: #6c757d;
            cursor: not-allowed;
            opacity: 0.6;
        }
        
        .step-indicator {
            display: flex;
            justify-content: center;
            margin-bottom: 2rem;
        }
        
        .step {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 1rem;
            font-weight: bold;
        }
        
        .step.active {
            background-color: #28a745;
            color: white;
        }
        
        .step.completed {
            background-color: #17a2b8;
            color: white;
        }
    </style>
</head>
<body>
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4 fw-bold mb-3">
                        <i class="fas fa-calendar-check me-3"></i>
                        Agende seu Horário
                    </h1>
                    <p class="lead mb-4">@Model.Loja.Descricao</p>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-store me-2"></i>
                        <span class="h5 mb-0">@Model.Loja.Nome</span>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <i class="fas fa-calendar-alt fa-5x opacity-75"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container my-5">
        <!-- Step Indicator -->
        <div class="step-indicator">
            <div class="step active" id="step1">1</div>
            <div class="step" id="step2">2</div>
            <div class="step" id="step3">3</div>
            <div class="step" id="step4">4</div>
        </div>

        <!-- Step 1: Selecionar Serviço -->
        <div class="step-content" id="step1-content">
            <div class="row">
                <div class="col-12">
                    <h2 class="mb-4">
                        <i class="fas fa-cogs me-2 text-primary"></i>
                        Escolha o Serviço
                    </h2>
                    <p class="text-muted mb-4">Selecione o serviço que deseja agendar:</p>
                </div>
            </div>
            
            <div class="row g-4" id="servicos-container">
                @foreach (var servico in Model.Servicos)
                {
                    var prestador = Model.Prestadores.FirstOrDefault(p => p.Id == servico.PrestadorId);
                    <div class="col-md-6 col-lg-4">
                        <div class="card service-card h-100" data-servico-id="@servico.Id" data-prestador-id="@servico.PrestadorId">
                            <div class="card-body">
                                <h5 class="card-title text-primary">@servico.Nome</h5>
                                <p class="card-text text-muted">@servico.Descricao</p>
                                
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-success fs-6">
                                        <i class="fas fa-dollar-sign me-1"></i>
                                        @servico.Valor.ToString("C")
                                    </span>
                                    <span class="badge bg-info">
                                        <i class="fas fa-clock me-1"></i>
                                        @servico.DuracaoEmMinutos min
                                    </span>
                                </div>
                                
                                @if (prestador != null)
                                {
                                    <div class="text-muted small">
                                        <i class="fas fa-user me-1"></i>
                                        @prestador.Nome
                                        <br>
                                        <i class="fas fa-briefcase me-1"></i>
                                        @prestador.AreaAtuacao
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <div class="text-center mt-4">
                <button type="button" class="btn btn-primary btn-lg" id="btn-next-step1" disabled>
                    Continuar <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>

        <!-- Step 2: Selecionar Data -->
        <div class="step-content" id="step2-content" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <h2 class="mb-4">
                        <i class="fas fa-calendar me-2 text-primary"></i>
                        Escolha a Data
                    </h2>
                    <p class="text-muted mb-4">Selecione a data para o seu agendamento:</p>
                </div>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body text-center">
                            <input type="text" id="data-agendamento" class="form-control form-control-lg text-center" placeholder="Selecione a data">
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Datas disponíveis são destacadas no calendário
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <button type="button" class="btn btn-outline-secondary me-3" id="btn-prev-step2">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </button>
                <button type="button" class="btn btn-primary btn-lg" id="btn-next-step2" disabled>
                    Continuar <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>

        <!-- Step 3: Selecionar Horário -->
        <div class="step-content" id="step3-content" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <h2 class="mb-4">
                        <i class="fas fa-clock me-2 text-primary"></i>
                        Escolha o Horário
                    </h2>
                    <p class="text-muted mb-4">Selecione o horário disponível:</p>
                </div>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-body">
                            <div id="loading-horarios" class="text-center py-4" style="display: none;">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Carregando...</span>
                                </div>
                                <p class="mt-2">Carregando horários disponíveis...</p>
                            </div>
                            
                            <div id="horarios-container" class="d-flex flex-wrap justify-content-center">
                                <!-- Horários serão carregados aqui -->
                            </div>
                            
                            <div id="sem-horarios" class="text-center py-4" style="display: none;">
                                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Nenhum horário disponível para esta data.</p>
                                <p class="text-muted small">Tente selecionar outra data.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <button type="button" class="btn btn-outline-secondary me-3" id="btn-prev-step3">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </button>
                <button type="button" class="btn btn-primary btn-lg" id="btn-next-step3" disabled>
                    Continuar <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>

        <!-- Step 4: Dados do Cliente -->
        <div class="step-content" id="step4-content" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <h2 class="mb-4">
                        <i class="fas fa-user me-2 text-primary"></i>
                        Seus Dados
                    </h2>
                    <p class="text-muted mb-4">Preencha suas informações para finalizar o agendamento:</p>
                </div>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-body">
                            <form id="form-agendamento">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="nome-cliente" class="form-label">
                                                <i class="fas fa-user me-2"></i>Nome Completo <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control" id="nome-cliente" name="NomeCliente" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="email-cliente" class="form-label">
                                                <i class="fas fa-envelope me-2"></i>E-mail <span class="text-danger">*</span>
                                            </label>
                                            <input type="email" class="form-control" id="email-cliente" name="EmailCliente" required>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="telefone-cliente" class="form-label">
                                                <i class="fas fa-phone me-2"></i>Telefone <span class="text-danger">*</span>
                                            </label>
                                            <input type="tel" class="form-control" id="telefone-cliente" name="TelefoneCliente" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="observacoes" class="form-label">
                                                <i class="fas fa-comment me-2"></i>Observações
                                            </label>
                                            <textarea class="form-control" id="observacoes" name="Observacoes" rows="3"></textarea>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Resumo do Agendamento -->
                                <div class="alert alert-info">
                                    <h6 class="alert-heading">
                                        <i class="fas fa-info-circle me-2"></i>Resumo do Agendamento
                                    </h6>
                                    <div id="resumo-agendamento">
                                        <!-- Resumo será preenchido aqui -->
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <button type="button" class="btn btn-outline-secondary me-3" id="btn-prev-step4">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </button>
                <button type="button" class="btn btn-success btn-lg" id="btn-finalizar-agendamento">
                    <i class="fas fa-check me-2"></i>Finalizar Agendamento
                </button>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-check-circle me-2"></i>Agendamento Confirmado!
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="fas fa-calendar-check fa-4x text-success mb-3"></i>
                    <h4>Parabéns!</h4>
                    <p>Seu agendamento foi realizado com sucesso.</p>
                    <p class="text-muted">Você receberá uma confirmação por e-mail em breve.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                        <i class="fas fa-check me-2"></i>OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>
    
    <script>
        // Variáveis globais
        let servicoSelecionado = null;
        let prestadorSelecionado = null;
        let dataSelecionada = null;
        let horarioSelecionado = null;
        let currentStep = 1;

        // Inicialização
        document.addEventListener('DOMContentLoaded', function() {
            initializeFlatpickr();
            setupEventListeners();
        });

        function initializeFlatpickr() {
            flatpickr("#data-agendamento", {
                locale: "pt",
                dateFormat: "d/m/Y",
                minDate: "today",
                disable: [
                    function(date) {
                        // Desabilitar domingos (0) e sábados (6) se necessário
                        return date.getDay() === 0;
                    }
                ],
                onChange: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length > 0) {
                        dataSelecionada = selectedDates[0];
                        document.getElementById('btn-next-step2').disabled = false;
                    }
                }
            });
        }

        function setupEventListeners() {
            // Seleção de serviços
            document.querySelectorAll('.service-card').forEach(card => {
                card.addEventListener('click', function() {
                    // Remover seleção anterior
                    document.querySelectorAll('.service-card').forEach(c => c.classList.remove('selected'));
                    
                    // Selecionar atual
                    this.classList.add('selected');
                    
                    // Armazenar dados
                    servicoSelecionado = {
                        id: this.dataset.servicoId,
                        nome: this.querySelector('.card-title').textContent,
                        prestadorId: this.dataset.prestadorId
                    };
                    
                    prestadorSelecionado = {
                        id: this.dataset.prestadorId,
                        nome: this.querySelector('.text-muted small').textContent.split('\n')[0].trim()
                    };
                    
                    document.getElementById('btn-next-step1').disabled = false;
                });
            });

            // Navegação entre steps
            document.getElementById('btn-next-step1').addEventListener('click', () => nextStep(2));
            document.getElementById('btn-next-step2').addEventListener('click', () => nextStep(3));
            document.getElementById('btn-next-step3').addEventListener('click', () => nextStep(4));
            
            document.getElementById('btn-prev-step2').addEventListener('click', () => prevStep(1));
            document.getElementById('btn-prev-step3').addEventListener('click', () => prevStep(2));
            document.getElementById('btn-prev-step4').addEventListener('click', () => prevStep(3));
            
            // Finalizar agendamento
            document.getElementById('btn-finalizar-agendamento').addEventListener('click', finalizarAgendamento);
        }

        function nextStep(step) {
            if (step === 3) {
                carregarHorariosDisponiveis();
            } else if (step === 4) {
                atualizarResumoAgendamento();
            }
            
            showStep(step);
            updateStepIndicator(step);
        }

        function prevStep(step) {
            showStep(step);
            updateStepIndicator(step);
        }

        function showStep(step) {
            // Esconder todos os steps
            document.querySelectorAll('.step-content').forEach(content => {
                content.style.display = 'none';
            });
            
            // Mostrar step atual
            document.getElementById(`step${step}-content`).style.display = 'block';
            currentStep = step;
        }

        function updateStepIndicator(step) {
            document.querySelectorAll('.step').forEach((stepEl, index) => {
                stepEl.classList.remove('active', 'completed');
                if (index + 1 < step) {
                    stepEl.classList.add('completed');
                } else if (index + 1 === step) {
                    stepEl.classList.add('active');
                }
            });
        }

        async function carregarHorariosDisponiveis() {
            if (!servicoSelecionado || !dataSelecionada) return;

            const loadingEl = document.getElementById('loading-horarios');
            const containerEl = document.getElementById('horarios-container');
            const semHorariosEl = document.getElementById('sem-horarios');

            loadingEl.style.display = 'block';
            containerEl.innerHTML = '';
            semHorariosEl.style.display = 'none';

            try {
                const dataFormatada = dataSelecionada.toISOString().split('T')[0];
                const response = await fetch(`/agendamento/@Model.Loja.Slug/horarios?prestadorId=${servicoSelecionado.prestadorId}&servicoId=${servicoSelecionado.id}&data=${dataFormatada}`);
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.data.length > 0) {
                        renderizarHorarios(result.data);
                        containerEl.style.display = 'block';
                    } else {
                        semHorariosEl.style.display = 'block';
                    }
                } else {
                    throw new Error('Erro ao carregar horários');
                }
            } catch (error) {
                console.error('Erro:', error);
                semHorariosEl.style.display = 'block';
            } finally {
                loadingEl.style.display = 'none';
            }
        }

        function renderizarHorarios(horarios) {
            const container = document.getElementById('horarios-container');
            
            container.innerHTML = horarios.map(horario => `
                <div class="time-slot" data-hora-inicio="${horario.horaInicio}" data-hora-fim="${horario.horaFim}">
                    <i class="fas fa-clock me-2"></i>
                    ${horario.horaInicio} - ${horario.horaFim}
                </div>
            `).join('');

            // Event listeners para seleção de horário
            container.querySelectorAll('.time-slot').forEach(slot => {
                slot.addEventListener('click', function() {
                    document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
                    this.classList.add('selected');
                    
                    horarioSelecionado = {
                        horaInicio: this.dataset.horaInicio,
                        horaFim: this.dataset.horaFim
                    };
                    
                    document.getElementById('btn-next-step3').disabled = false;
                });
            });
        }

        function atualizarResumoAgendamento() {
            const resumoEl = document.getElementById('resumo-agendamento');
            
            resumoEl.innerHTML = `
                <div class="row">
                    <div class="col-md-6">
                        <strong>Serviço:</strong><br>
                        ${servicoSelecionado.nome}
                    </div>
                    <div class="col-md-6">
                        <strong>Prestador:</strong><br>
                        ${prestadorSelecionado.nome}
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-6">
                        <strong>Data:</strong><br>
                        ${dataSelecionada.toLocaleDateString('pt-BR')}
                    </div>
                    <div class="col-md-6">
                        <strong>Horário:</strong><br>
                        ${horarioSelecionado.horaInicio} - ${horarioSelecionado.horaFim}
                    </div>
                </div>
            `;
        }

        async function finalizarAgendamento() {
            if (!servicoSelecionado || !dataSelecionada || !horarioSelecionado) {
                alert('Por favor, complete todas as etapas do agendamento.');
                return;
            }

            const form = document.getElementById('form-agendamento');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            const agendamentoData = {
                prestadorId: servicoSelecionado.prestadorId,
                servicoId: servicoSelecionado.id,
                data: dataSelecionada.toISOString().split('T')[0],
                horaInicio: horarioSelecionado.horaInicio,
                horaFim: horarioSelecionado.horaFim,
                nomeCliente: formData.get('NomeCliente'),
                emailCliente: formData.get('EmailCliente'),
                telefoneCliente: formData.get('TelefoneCliente'),
                observacoes: formData.get('Observacoes')
            };

            try {
                const response = await fetch(`/agendamento/@Model.Loja.Slug/criar`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(agendamentoData)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        // Mostrar modal de sucesso
                        const modal = new bootstrap.Modal(document.getElementById('successModal'));
                        modal.show();
                        
                        // Resetar formulário e voltar ao início
                        setTimeout(() => {
                            modal.hide();
                            resetarAgendamento();
                        }, 3000);
                    } else {
                        alert('Erro ao criar agendamento: ' + result.message);
                    }
                } else {
                    throw new Error('Erro na requisição');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Erro ao finalizar agendamento. Tente novamente.');
            }
        }

        function resetarAgendamento() {
            // Resetar variáveis
            servicoSelecionado = null;
            prestadorSelecionado = null;
            dataSelecionada = null;
            horarioSelecionado = null;
            
            // Resetar interface
            document.querySelectorAll('.service-card').forEach(c => c.classList.remove('selected'));
            document.getElementById('data-agendamento').value = '';
            document.getElementById('form-agendamento').reset();
            
            // Voltar ao primeiro step
            showStep(1);
            updateStepIndicator(1);
            
            // Desabilitar botões
            document.getElementById('btn-next-step1').disabled = true;
            document.getElementById('btn-next-step2').disabled = true;
            document.getElementById('btn-next-step3').disabled = true;
        }
    </script>
</body>
</html>

